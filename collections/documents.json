{
  "name": "documents",
  "type": "base",
  "schema": [
    {
      "name": "member",
      "type": "relation",
      "required": true,
      "options": { "collectionId": "members", "cascadeDelete": true, "maxSelect": 1 }
    },
    {
      "name": "type",
      "type": "select",
      "required": true,
      "default": "noc",
      "options": { "maxSelect": 1, "values": ["noc"] }
    },
    {
      "name": "event_name",
      "type": "text",
      "required": true,
      "options": { "min": 2, "max": 200 }
    },
    {
      "name": "start_date",
      "type": "date",
      "required": true
    },
    {
      "name": "end_date",
      "type": "date",
      "required": false
    },
    {
      "name": "note",
      "type": "text",
      "required": false,
      "options": { "max": 1000 }
    },
    {
      "name": "status",
      "type": "select",
      "required": true,
      "default": "pending",
      "options": { "maxSelect": 1, "values": ["pending", "generated", "rejected"] }
    },
    {
      "name": "generated_pdf",
      "type": "file",
      "required": false,
      "options": { "maxSelect": 1, "maxSize": 10485760, "mimeTypes": ["application/pdf"] }
    }
  ],
  "listRule": "@request.auth.role = 'admin' || member = @request.auth.id",
  "viewRule": "@request.auth.role = 'admin' || member = @request.auth.id",
  "createRule": "@request.auth.id != ''",
  "updateRule": "@request.auth.role = 'admin'",
  "deleteRule": "@request.auth.role = 'admin'"
}